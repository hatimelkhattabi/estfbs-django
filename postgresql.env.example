# Exemple à reporter dans votre .env APRÈS export_postgresql.
# Conservez vos autres paramètres, votre SECRET_KEY et .django-local-key.
DB_ENGINE=postgresql
DB_NAME=estfbs_django
DB_USER=estfbs_app
DB_PASSWORD="VOTRE_MOT_DE_PASSE_POSTGRESQL"
DB_HOST=127.0.0.1
DB_PORT=5432
# Pour un serveur distant, adaptez le mode SSL à sa configuration.
DB_SSLMODE=prefer
