DEBUG=true
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CSRF_TRUSTED_ORIGINS=
# SQLite fonctionne directement. Pour MySQL, utilisez une NOUVELLE base cible.
DB_ENGINE=sqlite
DB_NAME=estfbs_django
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
# Source Laravel facultative pour la commande import_laravel --mysql
LARAVEL_DB_NAME=estfbs_laravel
LARAVEL_DB_USER=root
LARAVEL_DB_PASSWORD=
LARAVEL_DB_HOST=127.0.0.1
LARAVEL_DB_PORT=3306
# Notifications facultatives : console par défaut.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
CONTACT_EMAIL=
DEFAULT_FROM_EMAIL=estfbs@usms.ac.ma
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
